# cluster.env
#
# API keys and secrets for the vLLM cluster orchestrator.
# Sourced locally by vllm_cluster_orchestrator.sh at startup.
# Values are passed as -e flags into containers at docker run / docker exec time.
# This file is NEVER copied to nodes — keys live only in the orchestrator process.
#
# Add this file to .gitignore. Commit cluster.env.template instead.
#
# Usage:
#   cp cluster.env.template cluster.env
#   # Edit cluster.env with real values
#   # The orchestrator sources this automatically — no other steps needed.

# ------------------------------------------------------------------------------
# Hugging Face
# ------------------------------------------------------------------------------
# Required for gated models (Llama, Gemma, etc.)
# Set HF_HUB_OFFLINE=1 in the model profile to bypass this for NFS-resident models.
#HF_TOKEN=hf_...

# ------------------------------------------------------------------------------
# OpenAI-compatible API keys
# Passed through if you're proxying external endpoints via the cluster.
# ------------------------------------------------------------------------------
#OPENAI_API_KEY=sk-...

# ------------------------------------------------------------------------------
# Custom / internal API keys
# Add any keys your containers need here, one per line.
# Format: KEY_NAME=value
# All non-empty, non-comment lines are injected into containers automatically.
# ------------------------------------------------------------------------------
#ANTHROPIC_API_KEY=sk-ant-...
#WANDB_API_KEY=...
